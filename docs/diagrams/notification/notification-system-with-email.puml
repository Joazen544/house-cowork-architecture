@startuml notification-system-with-email

package "Notification Module" {
  [NotificationService]
}

package "Email Module" {
  [EmailService] --> [EmailTemplatesRepository]
  [EmailService] --> [EmailNotificationsRepository]
  [SendEmailService] --> [EmailTemplatesRepository]
  [SendEmailService] --> [EmailNotificationsRepository]
}

[NotificationService] --> [EmailService]
[NotificationService] --> [SendEmailService]
@enduml